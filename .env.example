PORT=5173
SESSION_SECRET=replace-with-a-long-random-secret
# Separate key for encrypting stored Google tokens at rest. Leave blank to derive
# it from SESSION_SECRET (legacy behaviour). Set a long random value so that
# rotating SESSION_SECRET does not make previously stored Google tokens unreadable.
ENCRYPTION_KEY=
APP_BASE_URL=http://localhost:5173
COOKIE_SECURE=false
# Set to true ONLY when the app runs behind a reverse proxy/load balancer you
# control (nginx, Cloudflare, a cloud LB). When true, X-Forwarded-For / -Proto are
# trusted for the client IP and scheme. Keep false for direct exposure, otherwise
# clients can forge these headers to spoof their IP and bypass rate limiting.
TRUST_PROXY=false

# PostgreSQL storage (Docker). These three feed docker-compose.yml. For local dev the
# value below is fine; use a strong password in production.
POSTGRES_DB=card2leads
POSTGRES_USER=card2leads
POSTGRES_PASSWORD=card2leads_local_dev
DATABASE_URL=postgres://card2leads:card2leads_local_dev@localhost:55432/card2leads
DATABASE_SSL=false

# Optional AI extraction. Without this, uploads use a safe mock extraction
# and every card remains editable before save.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
EXTRACTION_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_VERIFICATION_MODEL=gpt-4.1-mini
EXTRACTION_VERIFICATION_MODE=
# Number of card extractions processed together. Start with 3; lower it if
# the AI provider rate-limits the account, or raise it cautiously up to 5.
EXTRACTION_CONCURRENCY=3

# Voice-note transcription. In auto mode Google STT is tried first when its
# service account is configured, then OpenAI is used as the fallback.
VOICE_STT_PROVIDER=auto
GOOGLE_STT_MODEL=latest_short
GOOGLE_STT_LANGUAGE_CODE=hi-IN
GOOGLE_STT_ALTERNATIVE_LANGUAGE_CODES=en-IN,en-US
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_VOICE_NOTE_MODEL=gpt-4.1-mini

# Optional Google Sheets and Google Contacts OAuth / API integration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/google/callback
GOOGLE_AUTH_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# Production email delivery is required for real verification/reset emails.
# Local development prints verification/reset links in the terminal/API response.
EMAIL_FROM=no-reply@yourdomain.com
RESEND_API_KEY=
SENDGRID_API_KEY=

# Razorpay is not wired into the application yet. These values are reserved
# for the billing implementation and must remain server-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MONTHLY_PLAN_ID=
RAZORPAY_QUARTERLY_PLAN_ID=
RAZORPAY_ANNUAL_PLAN_ID=

# ---------------------------------------------------------------------------
# Admin Panel (Card2Leads Admin — see F:\Card2leadsAdmin).
# On boot, if this email has no admin_users row yet, a Super Admin is seeded
# with the password below. Remove the password after the first successful boot.
# You can also create/reset admins any time with: node scripts/create-admin.js
# ---------------------------------------------------------------------------
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Super Admin
# Optional in development, required for the first-admin browser setup in
# production. Once the first admin exists, the setup endpoint disables itself.
ADMIN_SETUP_TOKEN=

# Demo / test account exemption. This ONE email bypasses pay-to-start and scans
# without limit (for demos). Set the SAME value in production so the demo works
# there too. DEMO_ACCOUNT_SCANS is the nominal allowance (demo is effectively
# unlimited regardless).
DEMO_ACCOUNT_EMAIL=
DEMO_ACCOUNT_SCANS=500
