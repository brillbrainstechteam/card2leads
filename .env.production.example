# ---- Card2Leads production environment ----
# Copy to .env on the server and fill real values. NEVER commit the real .env.

# Core
NODE_ENV=production
PORT=5173
APP_BASE_URL=https://card2leads.brillbrainsconsultants.com
COOKIE_SECURE=true
# App runs behind Cloudflare + Caddy, so trust forwarded headers for the real client IP:
TRUST_PROXY=true
# Long random string (>=32 chars). Rotating it signs everyone out.
SESSION_SECRET=replace-with-a-long-random-secret
# Separate key for encrypting stored Google tokens (recommended in production).
ENCRYPTION_KEY=replace-with-another-long-random-secret

# PostgreSQL (Docker). These three feed docker-compose.yml. Generate a strong
# password, e.g.:  openssl rand -base64 24
POSTGRES_DB=card2leads
POSTGRES_USER=card2leads
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
# DATABASE_URL must match the three lines above. Port 55432 = the Docker host mapping,
# bound to localhost only. Keep the password identical to POSTGRES_PASSWORD.
DATABASE_URL=postgres://card2leads:CHANGE_ME_TO_A_STRONG_PASSWORD@127.0.0.1:55432/card2leads
DATABASE_SSL=false

# Pay-to-start: new accounts get zero scan access until they subscribe. The ONE
# demo account below is exempt and can scan without paying (for demos/testing).
# Defaults to tech@brillbrainsconsultants.com if unset; set empty to disable.
DEMO_ACCOUNT_EMAIL=
DEMO_ACCOUNT_SCANS=500

# How long a login stays valid (days) before another sign-in. Default 30.
SESSION_DAYS=30

# WhatsApp OTP login via Meta Cloud API (uses your existing WhatsApp Business
# number). Leave WHATSAPP_OTP_TEMPLATE empty to disable phone login.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# The name of your APPROVED Authentication-category template in WhatsApp Manager.
WHATSAPP_OTP_TEMPLATE=
# Template language code (must match the template, e.g. en_US or en).
WHATSAPP_OTP_LANG=en_US
# Standard Authentication templates include a copy-code button; set false only if
# your template has no button component.
WHATSAPP_OTP_INCLUDE_BUTTON=true
WHATSAPP_API_VERSION=v21.0
DEFAULT_PHONE_COUNTRY=91

# AI extraction. Gemini is the primary extractor; OpenAI (gpt-4.1-mini) is used
# ONLY as a fallback when a Gemini call fails. Keep the verification mode OFF so
# each card is read once by one model, not twice — "paid" would run a second
# OpenAI pass on every card and roughly double the per-scan cost.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
EXTRACTION_VERIFICATION_MODE=off
EXTRACTION_CONCURRENCY=5

# Admin panel first-run setup. Set this to a long random value before opening
# the public admin URL. The browser asks for it exactly once; setup permanently
# disables after the first admin is created. Alternatively use bootstrap vars
# or scripts/create-admin.js.
ADMIN_SETUP_TOKEN=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Super Admin

# Google OAuth (production redirect URIs must be registered in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://card2leads.brillbrainsconsultants.com/api/google/callback
GOOGLE_AUTH_REDIRECT_URI=https://card2leads.brillbrainsconsultants.com/api/auth/google/callback

# Email (required for real verification/reset mail; verify the sender domain first)
EMAIL_FROM=no-reply@brillbrainsconsultants.com
RESEND_API_KEY=
# or SENDGRID_API_KEY=

# Razorpay billing (start with TEST keys, switch to LIVE after activation)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MONTHLY_PLAN_ID=
RAZORPAY_QUARTERLY_PLAN_ID=
RAZORPAY_ANNUAL_PLAN_ID=
